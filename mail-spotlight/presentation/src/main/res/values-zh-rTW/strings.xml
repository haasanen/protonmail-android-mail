<resources>
  <string name="spotlight_screen_version_text">版本 %s</string>
  <string name="spotlight_screen_title">Proton Mail 有什麼新功能</string>
  <string name="spotlight_feature_item_discreet_icon_title">低調圖示</string>
  <string name="spotlight_feature_item_discreet_icon_description">保留預設的 Proton Mail 圖示，或將其偽裝成一般圖示以提升隱私。</string>
  <string name="spotlight_feature_item_tracking_protection_title">追蹤保護</string>
  <string name="spotlight_feature_item_tracking_protection_description">查看誰試圖透過隱藏像素和追蹤連結監控您，以及有多少嘗試已遭封鎖。</string>
  <string name="spotlight_feature_item_encryption_locks_title">加密鎖</string>
  <string name="spotlight_feature_item_encryption_locks_description">使用鎖定圖示來識別並驗證保護您訊息的加密類型。</string>
  <string name="spotlight_feature_item_headers_html_title">檢視標頭與 HTML</string>
  <string name="spotlight_feature_item_headers_html_description">檢查可疑訊息以確認其真實性，並揭露任何隱藏的追蹤元素。</string>
  <string name="spotlight_screen_got_it">知道了</string>
  <!-- Category View Spotlight -->
  <string name="spotlight_screen_category_view_title">Proton Mail 的最新功能</string>
  <string name="spotlight_screen_category_view_ui_enhancements_title">介面優化</string>
  <string name="spotlight_screen_category_view_ui_enhancements_subtitle">流暢的捲動、重新整理的版面配置等。</string>
  <string name="spotlight_screen_category_view_unread_filter_title">未讀篩選器</string>
  <string name="spotlight_screen_category_view_unread_filter_subtitle">目前位於底部，更方便存取。</string>
  <string name="spotlight_screen_category_view_categories_title">電子郵件分類</string>
  <string name="spotlight_screen_category_view_categories_subtitle">自動將郵件整理至實用的分類中。</string>
  <string name="spotlight_screen_category_view_main_b2c_title">未讀更容易觸及</string>
  <string name="spotlight_screen_category_view_main_b2c_subtitle">未讀篩選器現在位於收件匣的底部，讓您更容易觸及並在所有電子郵件和未讀訊息之間切換。</string>
  <string name="spotlight_screen_category_view_main_b2b_title">隨時掌握新郵件與\n未讀電子郵件</string>
  <string name="spotlight_screen_category_view_main_b2b_subtitle">未讀篩選器現在變得更明顯且觸手可及，讓您能快速掃描並處理未讀電子郵件。</string>
  <string name="spotlight_screen_category_view_secondary_b2c_title">您的收件匣，\n已自動整理</string>
  <string name="spotlight_screen_category_view_secondary_b2c_subtitle">您的收件匣現在已整理至「主要」、「社交」、「推廣」等分類，讓您更容易減少雜亂，並專注於重要的電子郵件上。</string>
  <string name="spotlight_screen_category_view_privacy_by_design">旨在保護隱私。進一步瞭解</string>
  <string name="spotlight_screen_category_view_secondary_b2b_title">分類功能登場。\n告別分心干擾。</string>
  <string name="spotlight_screen_category_view_secondary_b2b_subtitle">不再被電子報、更新和非緊急電子郵件分散注意力。有了全新的電子郵件分類，只有重要訊息會進入您的主要收件匣。</string>
  <string name="spotlight_screen_category_view_button_continue">繼續</string>
  <string name="spotlight_screen_category_view_button_try">試用分類</string>
  <string name="spotlight_screen_category_view_button_dismiss">在不啟用的情況下繼續</string>
</resources>
